{
  "video": {
    "aspect_ratio": "9:16",
    "target_duration_seconds": 60,
    "accepted_duration_range_seconds": [50, 70],
    "recommended_segment_count": [12, 18],
    "segment_duration_seconds": [2.5, 5.0]
  },
  "concepts": {
    "registry": "concepts/registry.json",
    "active": "fictional-media-lore",
    "selection": "explicit_concept_or_active"
  },
  "llm": {
    "default_provider": "openai_api",
    "providers": {
      "openai_api": {
        "endpoint": "https://api.openai.com/v1/chat/completions",
        "model_env": "OPENAI_MODEL",
        "default_model": "gpt-5.6"
      },
      "claude_code": {
        "command_env": "CLAUDE_COMMAND",
        "model_env": "CLAUDE_MODEL"
      },
      "codex_cli": {
        "command_env": "CODEX_COMMAND",
        "model_env": "CODEX_MODEL"
      },
      "chatgpt_prompt": {
        "output_dir": "output/prompts"
      }
    }
  },
  "script": {
    "language": "ko-KR",
    "max_segment_words": 24,
    "require_hook": true,
    "require_conclusion": true,
    "one_idea_per_segment": true
  },
  "reference": {
    "profile": "references/shorts-style-profile.md",
    "mode": "bootstrap_once",
    "required_for_each_episode": false,
    "recommended_sample_count": [3, 5],
    "analyze": [
      "hook",
      "narration_pacing",
      "caption_density",
      "title_card",
      "asset_mix",
      "ending_pattern"
    ]
  },
  "content": {
    "domain": "fictional_media_lore",
    "claim_types": [
      "official",
      "secondary_reference",
      "creative_interpretation"
    ],
    "allow_creative_interpretation": true,
    "label_interpretation_as_such": true
  },
  "media": {
    "strategy": "collect_then_manual_review",
    "first_implementation": "candidate_collection_only",
    "search_fallback_skill": "insane-search",
    "generation_fallback": "manual_only",
    "manifest_schema": "scripts/plan_media.py",
    "candidate_collector": "scripts/collect_media_candidates.py",
    "manual_candidate_importer": "scripts/import_media_candidates.py",
    "validation_script": "scripts/validate_media_manifest.py",
    "require_human_review_for": [
      "unknown_license",
      "official_copyrighted_asset",
      "cc_by_nc",
      "cc_by_nd"
    ],
    "preferred_order": [
      "licensed_web_asset",
      "human_reviewed_web_asset",
      "generated_image_after_explicit_approval"
    ],
    "required_attribution_fields": [
      "source_url",
      "license",
      "creator"
    ]
  },
  "tts": {
    "default_provider": "supertonic",
    "providers": {
      "supertonic": {
        "package": "supertonic",
        "model": "supertonic-3",
        "language": "ko",
        "default_voice": "F1",
        "default_speed": 1.4,
        "output_format": "wav",
        "local_only": true,
        "measure_actual_duration": true
      },
      "qwen3_tts": {
        "package": "qwen-tts",
        "model": "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice",
        "language": "Korean",
        "default_speaker": "Sohee",
        "output_format": "wav",
        "local_only": true,
        "measure_actual_duration": true
      },
      "elevenlabs": {
        "config_env": "ELEVENLABS_TTS_CONFIG",
        "profile_env": "ELEVENLABS_TTS_PROFILE",
        "default_model": "eleven_multilingual_v2",
        "default_output_format": "mp3_44100_128",
        "scene_audio": true,
        "measure_actual_duration": true
      }
    }
  }
}
