{
  "video": {
    "aspect_ratio": "9:16",
    "target_duration_seconds": 60,
    "accepted_duration_range_seconds": [50, 70],
    "recommended_segment_count": [12, 18],
    "segment_duration_seconds": [2.5, 5.0]
  },
  "concepts": {
    "registry": "concepts/registry.json",
    "active": "fictional-media-lore",
    "selection": "explicit_concept_or_active"
  },
  "llm": {
    "default_provider": "openai_api",
    "providers": {
      "openai_api": {
        "endpoint": "https://api.openai.com/v1/chat/completions",
        "model_env": "OPENAI_MODEL",
        "default_model": "gpt-5.6"
      },
      "claude_code": {
        "command_env": "CLAUDE_COMMAND",
        "model_env": "CLAUDE_MODEL"
      },
      "codex_cli": {
        "command_env": "CODEX_COMMAND",
        "model_env": "CODEX_MODEL"
      },
      "chatgpt_prompt": {
        "output_dir": "output/prompts"
      }
    }
  },
  "script": {
    "language": "ko-KR",
    "max_segment_words": 24,
    "require_hook": true,
    "require_conclusion": true,
    "one_idea_per_segment": true
  },
  "reference": {
    "profile": "references/shorts-style-profile.md",
    "mode": "bootstrap_once",
    "required_for_each_episode": false,
    "recommended_sample_count": [3, 5],
    "analyze": [
      "hook",
      "narration_pacing",
      "caption_density",
      "title_card",
      "asset_mix",
      "ending_pattern"
    ]
  },
  "content": {
    "domain": "fictional_media_lore",
    "claim_types": [
      "official",
      "secondary_reference",
      "creative_interpretation"
    ],
    "allow_creative_interpretation": true,
    "label_interpretation_as_such": true
  },
  "media": {
    "strategy": "collect_then_manual_review",
    "first_implementation": "candidate_collection_only",
    "search_fallback_skill": "insane-search",
    "generation_fallback": "manual_only",
    "layouts": {
      "full_frame": {"asset_count": 1, "positions": ["full"]},
      "split_2up_left_right": {"asset_count": 2, "positions": ["left", "right"]},
      "split_2up_top_bottom": {"asset_count": 2, "positions": ["top", "bottom"]},
      "sequence": {"min_asset_count": 2, "max_asset_count": 4, "positions": ["sequence"]}
    },
    "legacy_layout_aliases": {"split_2up": "split_2up_left_right"},
    "caption_safe_area": "bottom",
    "namuwiki_capture": {
      "provider": "namuwiki_capture",
      "mode": "mobile_browser_text_excerpt",
      "license_assumption": "CC BY-NC-SA 2.0 KR",
      "noncommercial_only": true,
      "capture_script": "scripts/capture_namuwiki.py"
    },
    "presentation": {
      "layouts": {
        "full_frame": {"asset_count": 1, "positions": ["full"]},
        "split_2up_left_right": {"asset_count": 2, "positions": ["left", "right"]},
        "split_2up_top_bottom": {"asset_count": 2, "positions": ["top", "bottom"]},
        "sequence": {"min_asset_count": 2, "max_asset_count": 4, "positions": ["sequence"]}
      },
      "legacy_layout_aliases": {"split_2up": "split_2up_left_right"},
      "transitions": {
        "allowed": ["fade", "slide_left", "slide_up", "cut"],
        "default": "fade",
        "duration_sec": 0.28,
        "avoid_consecutive_same": true,
        "max_consecutive_same": 1
      },
      "auto_planner": {
        "script": "scripts/plan_presentation.py",
        "low_confidence_requires_review": true,
        "stable_candidate_ids": true
      }
    },
    "manifest_schema": "scripts/plan_media.py",
    "manifest_migrator": "scripts/migrate_media_manifest.py",
    "candidate_collector": "scripts/collect_media_candidates.py",
    "manual_candidate_importer": "scripts/import_media_candidates.py",
    "review_report_script": "scripts/render_media_review.py",
    "validation_script": "scripts/validate_media_manifest.py",
    "require_human_review_for": [
      "unknown_license",
      "official_copyrighted_asset",
      "cc_by_nc",
      "cc_by_nd"
    ],
    "preferred_order": [
      "licensed_web_asset",
      "human_reviewed_web_asset",
      "generated_image_after_explicit_approval"
    ],
    "required_attribution_fields": [
      "source_url",
      "license",
      "creator"
    ]
  },
  "publish": {
    "platform": "youtube",
    "default_profile": "korean-shorts",
    "upload_privacy_status": "private",
    "require_manual_approval": true,
    "require_final_render": true,
    "commercial_use": false,
    "profiles": {
      "korean-shorts": {
        "category_id": "24",
        "default_language": "ko",
        "default_audio_language": "ko",
        "made_for_kids": false,
        "contains_synthetic_media": true,
        "base_tags": [],
        "footer": ""
      }
    },
    "limits": {
      "title_max_chars": 100,
      "description_max_bytes": 5000,
      "tags_max_total_chars": 500,
      "shorts_max_duration_seconds": 180
    },
    "ai_disclosure": {
      "required": true,
      "api_field": "status.containsSyntheticMedia",
      "description_sentence_ko": "이 영상의 내레이션은 AI 음성으로 생성되었습니다."
    },
    "manual_checklist": [
      "썸네일 또는 커버 프레임 확인",
      "재생목록 추가 여부 확인",
      "댓글 설정과 리믹스 허용 범위 확인",
      "업로드 후 저작권 클레임 확인",
      "게시 전 사실 검수 완료 확인"
    ],
    "overrides_dir": "config/publish",
    "scripts": {
      "planner": "scripts/plan_publish.py",
      "review_report": "scripts/render_publish_review.py",
      "approval": "scripts/approve_publish.py",
      "validator": "scripts/validate_publish.py",
      "licensing_module": "scripts/publish_licensing.py",
      "metadata_module": "scripts/publish_metadata.py",
      "validation_module": "scripts/publish_validation.py"
    }
  },
  "tts": {
    "default_provider": "supertonic",
    "providers": {
      "supertonic": {
        "package": "supertonic",
        "model": "supertonic-3",
        "language": "ko",
        "default_voice": "F1",
        "default_speed": 1.4,
        "output_format": "wav",
        "local_only": true,
        "measure_actual_duration": true
      },
      "qwen3_tts": {
        "package": "qwen-tts",
        "model": "Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice",
        "language": "Korean",
        "default_speaker": "Sohee",
        "output_format": "wav",
        "local_only": true,
        "measure_actual_duration": true
      },
      "elevenlabs": {
        "config_env": "ELEVENLABS_TTS_CONFIG",
        "profile_env": "ELEVENLABS_TTS_PROFILE",
        "default_model": "eleven_multilingual_v2",
        "default_output_format": "mp3_44100_128",
        "scene_audio": true,
        "measure_actual_duration": true
      }
    }
  }
}
